# MongoDB Connection URI (Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expense-tracker?retryWrites=true&w=majority

# Node environment state
NODE_ENV=development

# ---- Push notifications (credit-card due-date reminders) ----
# Generate a key pair with:  npx web-push generate-vapid-keys --json
# The public key must be prefixed NEXT_PUBLIC_ so the browser can subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to push services (any mailto or https URL)
VAPID_SUBJECT=mailto:reminders@fintrack.app
# Secret that protects the daily cron endpoint (Vercel Cron sends it automatically)
CRON_SECRET=
